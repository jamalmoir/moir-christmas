{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"installCommand": "npm install --ignore-scripts",
	"buildCommand": "npm run build",
	"outputDirectory": "dist",
	"rewrites": [
		{ "source": "/8bit", "destination": "/8bit.html" },
		{ "source": "/8bit/", "destination": "/8bit.html" }
	]
}
